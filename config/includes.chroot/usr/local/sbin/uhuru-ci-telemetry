#!/bin/bash
# Uhuru OS — telemetry ya CI: inaandika hali ya mfumo kwenye serial console kila sekunde 5.
# Inafanya kazi TU kwenye QEMU ya CI (QEMU -smbios type=1,serial=UHURU_CI). Kwenye kompyuta halisi inatoka mara moja.
# v13.9: kitanzi kikuu HAKIITI tena loginctl/systemctl/journalctl; kila amri ina timeout; ripoti nzito zinaendeshwa nyuma.
# v13.10: CHANZO HALISI cha telemetry kuacha kuandika: serial-getty@ttyS0 inapoanza huita vhangup() kwenye ttyS0, na hiyo
#        inakata faili zote zilizofunguliwa tayari (writes zinapata EIO kimya kimya). Kwa hiyo hatushikilii tena fd wazi:
#        kila mstari unaandikwa kwa kufungua /dev/ttyS0 upya (emit), na hivyo unaendelea kuandika baada ya getty kuanza.
DMI=${UHURU_TEST_DMI:-/sys/class/dmi/id/product_serial}
SERIAL=${UHURU_TEST_SERIAL:-/dev/ttyS0}
LOOPS=${UHURU_TEST_LOOPS:-0}
SLEEP=${UHURU_TEST_SLEEP:-5}
SESSDIR=${UHURU_TEST_SESSIONS:-/run/systemd/sessions}
grep -q 'UHURU_CI' "$DMI" 2>/dev/null || exit 0
exec 2>/dev/null
RUNDIR=${UHURU_TEST_RUN:-/run}
: > "$RUNDIR/uhuru-ci"; chmod 0644 "$RUNDIR/uhuru-ci"
: > "$RUNDIR/uhuru-setup.step"; chmod 0666 "$RUNDIR/uhuru-setup.step"
# emit: andika maandishi kwenye serial kwa kufungua upya kila mara (tee -a, chini ya timeout kama ufunguzi ukining'inia).
emit() { printf '%s\n' "$1" | timeout -k 1 3 tee -a "$SERIAL" >/dev/null 2>&1; }

# Orodha ya watumiaji wa session, kwa kusoma faili za logind moja kwa moja (bila D-Bus).
# Faili za *.ref ni FIFO (kuzisoma kunaning'inia), kwa hiyo tunasoma faili za kawaida tu.
sessions() {
    local f u out=""
    for f in "$SESSDIR"/*; do
        [ -f "$f" ] || continue
        case "$f" in *.ref) continue ;; esac
        u=$(sed -n 's/^USER=//p' "$f" 2>/dev/null | head -n 1)
        [ -n "$u" ] && out="$out$u,"
    done
    printf '%s' "$out"
}
# Hesabu ya michakato. Mchoro "[l]ightdm..." unazuia pgrep isijihesabu yenyewe kupitia cmdline ya 'timeout'.
cnt() { local c; c=$(timeout -k 1 3 pgrep "$@" 2>/dev/null); printf '%s' "${c:-0}"; }

accounts() {
    local u
    printf 'UHURU-ACCOUNTS'
    for u in $(timeout -k 1 3 getent passwd | awk -F: '$3>=1000 && $3<60000{print $1}'); do
        printf ' %s=%s' "$u" "$(timeout -k 1 3 passwd -S "$u" 2>/dev/null | awk '{print $2}')"
    done
    printf '\n'
}

# Ripoti nzito: inaendeshwa nyuma, inaandikwa kwa printf moja ili isichanganyike na mistari ya STATE.
report() {   # report <n> <auth:0|1> <diag:0|1>
    local n=$1 auth=$2 dg=$3 buf="" a=""
    d() { sed "s/^/UHURU-DIAG $1: /" | cut -c1-220; }
    if [ "$auth" = 1 ]; then
        a=$(timeout -k 1 8 journalctl -b -q --no-pager 2>/dev/null | grep -E 'pam_unix\(lightdm|authentication failure|uhuru-create-user' | tail -n 4 | sed 's/^/UHURU-AUTH /')
        [ -n "$a" ] && buf="$buf$a"$'\n'
    fi
    if [ "$dg" = 1 ]; then
        a=$(
            echo "UHURU-DIAG-BEGIN n=$n"
            timeout -k 1 4 loginctl list-sessions --no-legend 2>&1 | d loginctl
            ps -eo user:12,comm 2>/dev/null | grep -E 'lightdm|Xorg|xfce4-session|xfwm4|xfdesktop|zenity|light-locker|systemd --user' | sort | uniq -c | d ps
            echo "lightdm=$(timeout -k 1 4 systemctl is-active lightdm 2>/dev/null) live-config=$(timeout -k 1 4 systemctl is-active live-config 2>/dev/null) live-prep=$(timeout -k 1 4 systemctl is-active uhuru-live-prep 2>/dev/null)" | d units
            ls /usr/share/xsessions 2>&1 | tr '\n' ' ' | d xsessions
            grep -rn -E 'autologin|user-session|greeter-setup' /etc/lightdm/ 2>/dev/null | grep -v ':#' | d lightdm-conf
            tail -n 14 /var/log/lightdm/lightdm.log 2>&1 | d lightdm.log
            grep -E '\(EE\)|rror' /var/log/lightdm/x-0.log 2>/dev/null | tail -n 5 | d x-0.log
            tail -n 6 /var/log/lightdm/seat0-greeter.log 2>&1 | d greeter.log
            tail -n 10 /home/*/.xsession-errors 2>/dev/null | d xsession-errors
            timeout -k 1 8 journalctl -b -q --no-pager -u lightdm 2>/dev/null | tail -n 8 | d journal-lightdm
            timeout -k 1 8 journalctl -b -q --no-pager 2>/dev/null | grep -E 'xfce4-session|Failed to start|Failed with result|session.*(fail|abort)|pam_systemd' | tail -n 8 | d journal-session
            ls /etc/sudoers.d 2>&1 | tr '\n' ' ' | d sudoers
            tail -n 8 /tmp/uhuru-create-user.log 2>&1 | d create-user
            timeout -k 1 8 journalctl -b -q --no-pager 2>/dev/null | grep -E 'sudo|uhuru-relogin|useradd|chpasswd' | tail -n 6 | d sudo-journal
            ls /etc/lightdm/lightdm.conf.d 2>&1 | tr '\n' ' ' | d conf.d
            grep -h 'hidden-users' /etc/lightdm/users.conf 2>&1 | d hidden-users
            cat /var/lib/lightdm/.cache/lightdm-gtk-greeter/state 2>&1 | tr '\n' ' ' | d greeter-state
            echo "UHURU-DIAG-END"
        )
        buf="$buf$a"$'\n'
    fi
    printf '%s' "$buf"
}

# v14.0: ukaguzi wa awamu ya 4 (taskbar, Start menu, LGT Store). Dirisha la majaribio halionyeshwi (--smoke linatumia realize tu).
p4check() {
    local P=/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml cfg=no lch=no ic=no st gui=none xu
    if grep -q 'whiskermenu' "$P" 2>/dev/null && grep -q 'tasklist' "$P" 2>/dev/null && [ -f /etc/skel/.config/xfce4/panel/whiskermenu-1.rc ]; then cfg=ok; fi
    grep -q '^Exec=uhuru-store' /usr/share/applications/uhuru-store.desktop 2>/dev/null && lch=ok
    [ -f /usr/share/uhuru-store/icons/uhuru-start.svg ] && ic=ok
    st=$(timeout -k 1 25 /usr/local/bin/uhuru-store --check 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-80)
    if [ -e /var/lib/uhuru-setup.done ]; then
        xu=$(timeout -k 1 3 ps -C xfce4-session -o user= 2>/dev/null | head -n 1 | tr -d ' ')
        if [ -n "$xu" ]; then
            gui=$(timeout -k 2 40 runuser -u "$xu" -- env DISPLAY=:0 XAUTHORITY="/home/$xu/.Xauthority" /usr/local/bin/uhuru-store --smoke 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-80)
            [ -n "$gui" ] || gui=empty
        fi
    fi
    printf 'UHURU-P4 cfg=%s launcher=%s icons=%s store=%s gui=%s whisker=%s panel=%s' "$cfg" "$lch" "$ic" "${st:-empty}" "$gui" \
        "$(cnt -fc '[w]rapper-2.0.*whiskermenu')" "$(cnt -xc xfce4-panel)"
}
# v15.0: ukaguzi wa awamu ya 5 (offline-first, Uhuru Share, zram, ukaguzi wa vifaa).
p5check() {
    local files=no conf=no shr hw gui=none xu mt ma zr=inactive
    if [ -x /usr/local/bin/uhuru-share ] && [ -x /usr/local/bin/uhuru-hwcheck ] && [ -x /usr/local/sbin/uhuru-zram-setup ] \
        && [ -f /usr/share/applications/uhuru-share.desktop ] && [ -f /etc/systemd/system/uhuru-zram.service ]; then files=ok; fi
    if grep -q 'Timeout' /etc/apt/apt.conf.d/90uhuru-offline 2>/dev/null \
        && [ "$(readlink /etc/systemd/system/NetworkManager-wait-online.service 2>/dev/null)" = /dev/null ]; then conf=ok; fi
    shr=$(timeout -k 1 60 /usr/local/bin/uhuru-share --selftest 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-90)
    hw=$(timeout -k 1 25 /usr/local/bin/uhuru-hwcheck --check 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-60)
    mt=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)
    ma=$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)
    grep -q '^/dev/zram0' /proc/swaps 2>/dev/null && zr=active
    if [ -e /var/lib/uhuru-setup.done ]; then
        xu=$(timeout -k 1 3 ps -C xfce4-session -o user= 2>/dev/null | head -n 1 | tr -d ' ')
        if [ -n "$xu" ]; then
            gui=$(timeout -k 2 40 runuser -u "$xu" -- env DISPLAY=:0 XAUTHORITY="/home/$xu/.Xauthority" /usr/local/bin/uhuru-share --smoke 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-60)
            [ -n "$gui" ] || gui=empty
        fi
    fi
    printf 'UHURU-P5 files=%s conf=%s share=%s hw=%s gui=%s mem=%s avail=%s zram=%s' "$files" "$conf" "${shr:-empty}" "${hw:-empty}" "$gui" "${mt:-0}" "${ma:-0}" "$zr"
}
# v15.1: ukaguzi wa awamu ya 5.1 (locale, folda za mtumiaji, arifa).
p51check() {
    local en=no sw=no nd=no loc=na lang="" locerr=na xdg=na xdgwarn=na ntf=na xu pid envl bus gi E nname="" lcs=""
    locale -a 2>/dev/null | grep -qi '^en_US\.utf-\?8$' && en=ok
    locale -a 2>/dev/null | grep -qi '^sw_TZ\.utf-\?8$' && sw=ok
    dpkg -s xfce4-notifyd >/dev/null 2>&1 && nd=ok
    if [ -e /var/lib/uhuru-setup.done ]; then
        xu=$(timeout -k 1 3 ps -C xfce4-session -o user= 2>/dev/null | head -n 1 | tr -d ' ')
        pid=$(pgrep -u "$xu" -x xfce4-session 2>/dev/null | head -n 1)
        if [ -n "$xu" ] && [ -n "$pid" ]; then
            envl=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)
            lang=$(printf '%s\n' "$envl" | sed -n 's/^LANG=//p' | head -n 1 | tr -cd 'A-Za-z0-9_.@-' | cut -c1-24)
            bus=$(printf '%s\n' "$envl" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)
            if [ -z "$lang" ]; then loc=nolang
            elif LANG="$lang" LC_ALL="$lang" timeout -k 1 10 python3 -c 'import locale; locale.setlocale(locale.LC_ALL, "")' 2>/dev/null; then loc=ok
            else loc=bad; fi
            E="/home/$xu/.xsession-errors"
            locerr=$(grep -c 'Locale not supported' "$E" 2>/dev/null); [ -n "$locerr" ] || locerr=0
            xdgwarn=$(grep -c 'Failed to get Download dir' "$E" 2>/dev/null); [ -n "$xdgwarn" ] || xdgwarn=0
            if [ -f "/home/$xu/.config/user-dirs.dirs" ] && [ -d "/home/$xu/Downloads" ] && [ -d "/home/$xu/Documents" ]; then xdg=ok; else xdg=no; fi
            if [ -n "$bus" ]; then
                gi=$(timeout -k 2 20 runuser -u "$xu" -- env DBUS_SESSION_BUS_ADDRESS="$bus" gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.GetServerInformation 2>&1 | tail -n 1)
                case "$gi" in "('"*) ntf=ok ;; *) ntf=fail ;; esac   # huduma yoyote ya org.freedesktop.Notifications iliyojibu inatosha
                nname=$(printf '%s\n' "$gi" | sed -n "s/^('\\([^']*\\)'.*/\\1/p" | tr -cd 'A-Za-z0-9_.-' | cut -c1-24)
            else
                ntf=nobus
            fi
        fi
    fi
    lcs=$(locale -a 2>/dev/null | grep -Ei '^(en_US|sw_)' | tr '\n' ',' | tr -cd 'A-Za-z0-9_.,-' | cut -c1-60)
    printf 'UHURU-P51 en=%s sw=%s notifyd=%s loc=%s lang=%s locerr=%s xdg=%s xdgwarn=%s notify=%s nname=%s lcs=%s' "$en" "$sw" "$nd" "$loc" "${lang:-none}" "$locerr" "$xdg" "$xdgwarn" "$ntf" "${nname:-none}" "${lcs:-none}"
}
# v16.0: ukaguzi wa awamu ya 6 (bidhaa za Letema kama programu halisi, katalogi ya mbali).
p6win() {   # p6win <mtumiaji>: inafungua TraceTZ Hub kama programu na inathibitisha dirisha lake; matokeo: "<win> <class>"
    local xu=$1 xa bf af id wp cmdl cls="" win=noproc i
    xa="/home/$xu/.Xauthority"
    bf=$(DISPLAY=:0 XAUTHORITY="$xa" xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*' | sort -u)
    timeout -k 2 20 runuser -u "$xu" -- env HOME="/home/$xu" DISPLAY=:0 XAUTHORITY="$xa" gio launch "/home/$xu/.local/share/applications/lgt-tracetz.desktop" >/dev/null 2>&1
    for i in $(seq 1 60); do
        sleep 1
        if pgrep -u "$xu" -f -- '--class=lgt-tracetz' >/dev/null 2>&1; then win=nowin; fi
        af=$(DISPLAY=:0 XAUTHORITY="$xa" xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*' | sort -u)
        for id in $af; do
            printf '%s\n' "$bf" | grep -qx "$id" && continue
            wp=$(DISPLAY=:0 XAUTHORITY="$xa" xprop -id "$id" _NET_WM_PID 2>/dev/null | grep -o '[0-9]*$')
            [ -n "$wp" ] || continue
            cmdl=$(tr '\0' ' ' < "/proc/$wp/cmdline" 2>/dev/null)
            case "$cmdl" in
                *--app=*--class=lgt-tracetz*|*--class=lgt-tracetz*--app=*)
                    win=ok
                    cls=$(DISPLAY=:0 XAUTHORITY="$xa" xprop -id "$id" WM_CLASS 2>/dev/null | sed 's/.*= *//' | tr -d '" ' | tr -cd 'A-Za-z0-9_.,-' | cut -c1-80)
                    break 2 ;;
            esac
        done
    done
    pkill -u "$xu" -f 'uhuru-pwa/tracetz' 2>/dev/null
    for i in 1 2 3 4 5 6; do pgrep -u "$xu" -f 'uhuru-pwa/tracetz' >/dev/null 2>&1 || break; sleep 1; done
    pkill -KILL -u "$xu" -f 'uhuru-pwa/tracetz' 2>/dev/null
    sleep 1
    echo "$win ${cls:-none}" > /run/uhuru-p6-win.tmp && mv -f /run/uhuru-p6-win.tmp /run/uhuru-p6-win
}
p6check() {
    local files=no conf=no st real=na win=wait cls=none sync=wait xu d a f age pid sd ok=1
    if [ -f /etc/uhuru-store/remote.json ] && [ -x /usr/local/bin/uhuru-store ] && command -v xprop >/dev/null 2>&1 && command -v gio >/dev/null 2>&1; then files=ok; fi
    python3 -c 'import json,sys; sys.exit(0 if json.load(open("/etc/uhuru-store/remote.json"))["url"].startswith("https://") else 1)' 2>/dev/null && conf=ok
    st=$(HOME=/root timeout -k 1 60 /usr/local/bin/uhuru-store --p6-check 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-120)
    if [ ! -e /run/uhuru-p6-sync ]; then
        : > /run/uhuru-p6-sync
        echo "$(HOME=/root timeout -k 1 25 /usr/local/bin/uhuru-store --sync 2>&1 | tail -n 1 | tr -c 'A-Za-z0-9=_.,-' ' ' | tr -s ' ' ',' | cut -c1-40)" > /run/uhuru-p6-sync
    fi
    [ -s /run/uhuru-p6-sync ] && sync=$(tr -d '\n ' < /run/uhuru-p6-sync)
    if [ -e /var/lib/uhuru-setup.done ]; then
        xu=$(timeout -k 1 3 ps -C xfce4-session -o user= 2>/dev/null | head -n 1 | tr -d ' ')
        if [ -n "$xu" ]; then
            d="/home/$xu/.local/share/applications"
            for a in tracetz letema-web; do
                timeout -k 2 30 runuser -u "$xu" -- env HOME="/home/$xu" /usr/local/bin/uhuru-store --install-pwa "$a" >/dev/null 2>&1
                f="$d/lgt-$a.desktop"
                if [ -f "$f" ] && grep -q -- '--app=' "$f" && grep -q "^StartupWMClass=lgt-$a\$" "$f" && grep -q -- '--user-data-dir=' "$f" && grep -q '^Terminal=false' "$f"; then :; else ok=0; fi
            done
            [ "$ok" = 1 ] && real=ok || real=no
            if [ ! -e /run/uhuru-p6-win ]; then
                pid=$(pgrep -u "$xu" -f 'uhuru-share --gui' 2>/dev/null | head -n 1)
                age=0; [ -n "$pid" ] && age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
                sd=$(( $(date +%s) - $(stat -c %Y /var/lib/uhuru-setup.done 2>/dev/null || echo 0) ))
                if { [ -n "$pid" ] && [ "${age:-0}" -ge 15 ]; } || [ "$sd" -ge 360 ]; then
                    : > /run/uhuru-p6-win
                    [ "$real" = ok ] && p6win "$xu" || echo "skip none" > /run/uhuru-p6-win
                fi
            fi
            if [ -s /run/uhuru-p6-win ]; then read -r win cls < /run/uhuru-p6-win; elif [ -e /run/uhuru-p6-win ]; then win=running; fi
        fi
    fi
    printf 'UHURU-P6 files=%s conf=%s store=%s real=%s win=%s cls=%s sync=%s' "$files" "$conf" "${st:-empty}" "$real" "$win" "$cls" "$sync"
}
n=0; RPID=""; P4PID=""; P5PID=""; P51PID=""; P6PID=""
while :; do
    n=$((n+1))
    sess=$(sessions)
    xu=$(timeout -k 1 3 ps -C xfce4-session -o user= 2>/dev/null | sort -u | tr '\n' ',')
    al=$(timeout -k 1 3 grep -rhs '^autologin-' /etc/lightdm/ | tr '\n' '|')
    stp=$(head -c 20 "$RUNDIR/uhuru-setup.step" 2>/dev/null | tr -dc 'a-z0-9_-'); [ -n "$stp" ] || stp=none
    emit "$(printf 'UHURU-STATE n=%s sessions=%s xfceuser=%s zenity=%s step=%s greeter=%s xfce=%s locker=%s done=%s autologin=%s' \
        "$n" "$sess" "$xu" "$(cnt -xc zenity)" "$stp" "$(cnt -fc '[l]ightdm-gtk-greeter')" "$(cnt -xc xfce4-session)" \
        "$(cnt -xc light-locker)" "$([ -e /var/lib/uhuru-setup.done ] && echo yes || echo no)" "$al")"
    [ $((n % 2)) -eq 1 ] && emit "$(accounts)"
    if [ $((n % 4)) -eq 2 ] && { [ -z "$P51PID" ] || ! kill -0 "$P51PID" 2>/dev/null; }; then
        { emit "$(p51check)"; } &
        P51PID=$!
    fi
    if [ $((n % 4)) -eq 1 ] && { [ -z "$P5PID" ] || ! kill -0 "$P5PID" 2>/dev/null; }; then
        { emit "$(p5check)"; } &
        P5PID=$!
    fi
    if [ $((n % 4)) -eq 0 ] && { [ -z "$P6PID" ] || ! kill -0 "$P6PID" 2>/dev/null; }; then
        { emit "$(p6check)"; } &
        P6PID=$!
    fi
    if [ $((n % 4)) -eq 3 ] && { [ -z "$P4PID" ] || ! kill -0 "$P4PID" 2>/dev/null; }; then
        { emit "$(p4check)"; } &
        P4PID=$!
    fi
    A=0; D=0
    [ $((n % 4)) -eq 1 ] && A=1
    { [ "$n" -eq 2 ] || [ $((n % 12)) -eq 0 ]; } && D=1
    if [ $((A + D)) -gt 0 ] && { [ -z "$RPID" ] || ! kill -0 "$RPID" 2>/dev/null; }; then
        { r=$(report "$n" "$A" "$D"); [ -n "$r" ] && emit "$r"; } &
        RPID=$!
    fi
    if [ "$LOOPS" -gt 0 ] && [ "$n" -ge "$LOOPS" ]; then wait; exit 0; fi
    sleep "$SLEEP"
done
# v13.12
# v13.13
