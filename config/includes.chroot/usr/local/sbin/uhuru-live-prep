#!/bin/bash
# Uhuru OS — maandalizi ya live session. Inaendeshwa na uhuru-live-prep.service mapema wakati wa boot,
# baada ya live-config na kabla ya login screen. Haifanyi kitu kwenye mfumo uliosakinishwa.
R=${UHURU_TEST_ROOT:-}
CMDLINE=${UHURU_CMDLINE:-/proc/cmdline}
grep -q 'boot=live' "$CMDLINE" || exit 0
[ -e "$R/var/lib/uhuru-setup.done" ] && exit 0

BG="$R/usr/share/backgrounds/uhuru-os"
TZNAME=Africa/Dar_es_Salaam

# 1. Saa ya EAT (live-config huiweka UTC)
if [ -f "$R/usr/share/zoneinfo/$TZNAME" ]; then
    ln -sf "/usr/share/zoneinfo/$TZNAME" "$R/etc/localtime"
    echo "$TZNAME" > "$R/etc/timezone"
fi

# 2. Akaunti ya live (UID 1000)
LIVE_USER=${UHURU_TEST_LIVE_USER:-$(getent passwd 1000 | cut -d: -f1)}

# 3. Skrini ya login yenye maelezo ya kuingia mara ya kwanza (kwa akaunti zinazojulikana pekee)
case "$LIVE_USER" in
    mtumiaji) HINT=uhuru-os-login-hint-mtumiaji.png ;;
    user)     HINT=uhuru-os-login-hint-user.png ;;
    *)        HINT=uhuru-os-login.png ;;
esac
[ -f "$BG/$HINT" ] && ln -sf "/usr/share/backgrounds/uhuru-os/$HINT" "$BG/login-current.png"

# 4. Login screen ijaze jina la akaunti ya live kama mtumiaji wa mwisho
LD_HOME=${UHURU_TEST_LD_HOME:-$(getent passwd lightdm | cut -d: -f6)}
if [ -n "$LIVE_USER" ] && [ -n "$LD_HOME" ]; then
    mkdir -p "$R$LD_HOME/.cache/lightdm-gtk-greeter"
    printf '[greeter]\nlast-user=%s\n' "$LIVE_USER" > "$R$LD_HOME/.cache/lightdm-gtk-greeter/state"
    chown -R lightdm:lightdm "$R$LD_HOME/.cache" 2>/dev/null || true
fi
# 5. Ingia moja kwa moja kwenye akaunti ya live hadi mtumiaji ajisajili: mara ya kwanza hakuna password ya kuandika.
#    (Wizard inaondoa mpangilio huu mara akaunti ya mtumiaji inapotengenezwa.)
if [ -n "$LIVE_USER" ]; then
    mkdir -p "$R/etc/lightdm/lightdm.conf.d"
    printf '[Seat:*]\nautologin-user=%s\nautologin-user-timeout=0\n' "$LIVE_USER" > "$R/etc/lightdm/lightdm.conf.d/60-uhuru-live-autologin.conf"
fi
# 6. Mruhusu akaunti ya live kuendesha helper ya usajili kupitia sudo bila password
#    (haitegemei sudoers ya live-config; ruhusa ni kwa helper hiyo pekee)
if [ -n "$LIVE_USER" ] && printf '%s' "$LIVE_USER" | grep -Eq '^[a-z][a-z0-9_-]*$'; then
    mkdir -p "$R/etc/sudoers.d"
    SF="$R/etc/sudoers.d/uhuru-live"
    printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/uhuru-create-user\n' "$LIVE_USER" > "$SF.tmp"
    chmod 0440 "$SF.tmp"
    if [ -n "$R" ] || ! command -v visudo >/dev/null 2>&1 || visudo -cf "$SF.tmp" >/dev/null 2>&1; then
        mv "$SF.tmp" "$SF"
    else
        rm -f "$SF.tmp"
    fi
fi
exit 0
