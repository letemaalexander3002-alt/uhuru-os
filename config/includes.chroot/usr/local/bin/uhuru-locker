#!/bin/bash
# Uhuru OS — huanzisha light-locker, ISIPOKUWA kwenye live session kabla mtumiaji hajajisajili.
# (Skrini isijifunge na kuomba password ambayo mtumiaji hajaiunda bado.)
CMDLINE=${UHURU_CMDLINE:-/proc/cmdline}
R=${UHURU_TEST_ROOT:-}
if grep -q 'boot=live' "$CMDLINE" && [ ! -e "$R/var/lib/uhuru-setup.done" ]; then exit 0; fi
exec light-locker "$@"
