# ------------------------------------------------------------------ katalogi


def _read_json(path):
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def load_catalog(with_remote=True):
    """Katalogi kuu + catalog.d/*.json (zinabadilisha kwa 'id') + bidhaa za PWA kutoka Vendor Console (akiba ya mbali)."""
    cat = _read_json(os.path.join(SHARE, "catalog.json"))
    cats = {c["id"]: c for c in cat.get("categories", [])}
    apps = {a["id"]: a for a in cat.get("apps", [])}
    order = [a["id"] for a in cat.get("apps", [])]
    for path in sorted(glob.glob(os.path.join(CATALOG_D, "*.json"))):
        try:
            extra = _read_json(path)
        except Exception as exc:  # faili mbovu isiangushe duka
            sys.stderr.write("catalog.d: %s: %s\n" % (path, exc))
            continue
        for c in extra.get("categories", []):
            cats[c["id"]] = dict(cats.get(c["id"], {}), **c)
        for a in extra.get("apps", []):
            if a["id"] not in apps:
                order.append(a["id"])
            apps[a["id"]] = dict(apps.get(a["id"], {}), **a)
    result = {"categories": list(cats.values()), "apps": [apps[i] for i in order]}
    if with_remote:
        try:
            _apply_remote(result)
        except Exception as exc:  # akiba mbovu isiangushe duka
            sys.stderr.write("remote-catalog: %s\n" % exc)
    return result


def _ctl_free(text):
    return isinstance(text, str) and all(ord(c) >= 32 and ord(c) != 127 for c in text)


def decode_png_data_uri(uri):
    prefix = "data:image/png;base64,"
    if not isinstance(uri, str) or not uri.startswith(prefix) or len(uri) > MAX_ICON * 2:
        raise ValueError("ikoni si PNG (data URI)")
    try:
        raw = base64.b64decode(uri[len(prefix):], validate=True)
    except Exception:
        raise ValueError("ikoni: base64 si sahihi")
    if len(raw) > MAX_ICON or not raw.startswith(PNG_MAGIC):
        raise ValueError("ikoni si PNG halali au ni kubwa")
    return raw


def sanitize_remote_app(a, cat_ids):
    """Inarudisha dict safi au inatupa ValueError(sababu). Aina inayokubaliwa: pwa tu, anwani: https tu."""
    if not isinstance(a, dict):
        raise ValueError("kipengele si object")
    if a.get("type", "pwa") != "pwa":
        raise ValueError("aina si pwa")
    aid = a.get("id")
    if not isinstance(aid, str) or not ID_RE.match(aid):
        raise ValueError("id si sahihi")
    out = {"id": aid, "type": "pwa", "source": "vendor"}
    for key, limit, required in (("name", 60, True), ("summary", 240, True), ("keywords", 200, False)):
        val = a.get(key, "")
        if not isinstance(val, str) or not _ctl_free(val) or len(val) > limit or (required and not val.strip()):
            raise ValueError("%s si sahihi" % key)
        out[key] = val.strip()
    cat = a.get("category", "letema")
    if cat not in cat_ids:
        raise ValueError("kundi lisilojulikana")
    out["category"] = cat
    url = a.get("url")
    if not isinstance(url, str) or len(url) > 300 or not URL_RE.match(url):
        raise ValueError("url si https sahihi")
    out["url"] = url
    prio = a.get("priority", 50)
    if not isinstance(prio, int) or isinstance(prio, bool) or not -1000 <= prio <= 1000:
        raise ValueError("priority si sahihi")
    out["priority"] = prio
    out["enabled"] = a.get("enabled", True) is not False
    if a.get("icon_png"):
        out["_icon_bytes"] = decode_png_data_uri(a["icon_png"])
    return out


def parse_remote(data, cat_ids):
    """Inarudisha (apps_safi, kataliwa[(id, sababu)]). Inatupa ValueError ikiwa muundo mzima si sahihi."""
    if not isinstance(data, dict) or data.get("format") != 1 or not isinstance(data.get("apps"), list):
        raise ValueError("muundo wa katalogi ya mbali si sahihi")
    good, bad, seen = [], [], set()
    for a in data["apps"][:MAX_REMOTE_APPS]:
        aid = a.get("id") if isinstance(a, dict) else None
        try:
            app = sanitize_remote_app(a, cat_ids)
            if app["id"] in seen:
                raise ValueError("id imerudiwa")
            seen.add(app["id"])
            good.append(app)
        except ValueError as exc:
            bad.append((str(aid)[:41], str(exc)))
    return good, bad


def _remote_cache_path():
    return os.path.join(CACHE_DIR, "remote-catalog.json")


def _write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".part"
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.replace(tmp, path)


def load_remote_apps(cat_ids):
    """Bidhaa safi kutoka akiba ya mwisho (inafanya kazi bila mtandao). Ikoni zinaandikwa kwenye CACHE_DIR/icons."""
    path = _remote_cache_path()
    if not os.path.isfile(path) or os.path.getsize(path) > MAX_REMOTE:
        return []
    with open(path, "rb") as fh:
        data = json.loads(fh.read().decode("utf-8"))
    apps, _bad = parse_remote(data, cat_ids)
    for app in apps:
        raw = app.pop("_icon_bytes", None)
        if raw:
            icon = os.path.join(CACHE_DIR, "icons", app["id"] + ".png")
            if not os.path.isfile(icon) or os.path.getsize(icon) != len(raw):
                _write_atomic(icon, raw)
            app["icon_file"] = icon
    return apps


def _apply_remote(cat):
    cids = {c["id"] for c in cat["categories"]}
    apps = {a["id"]: a for a in cat["apps"]}
    order = [a["id"] for a in cat["apps"]]
    for r in load_remote_apps(cids):
        cur = apps.get(r["id"])
        if cur is not None and cur["type"] != "pwa":
            continue  # bidhaa ya mbali haiwezi kubadilisha programu ya apt
        if not r["enabled"]:
            if cur is not None:
                apps.pop(r["id"])
                order.remove(r["id"])
            continue
        merged = dict(cur or {}, **{k: v for k, v in r.items() if k != "enabled"})
        if cur is None:
            order.append(r["id"])
        apps[r["id"]] = merged
    cat["apps"] = [apps[i] for i in order]


def remote_url():
    for path in (USER_REMOTE_CONF, REMOTE_CONF):
        try:
            conf = _read_json(path)
        except Exception:
            continue
        if conf.get("enabled", True) is False:
            return None
        url = conf.get("url")
        if isinstance(url, str) and url.startswith("https://") and len(url) < 400:
            return url
    return None


def fetch_remote(url=None, allow_http=False, timeout=8):
    """Inapakua katalogi ya Vendor Console. Inarudisha (imebadilika, idadi_ya_bidhaa_halali). Inatupa kosa mtandao ukikosekana."""
    url = url or remote_url()
    if not url:
        return False, 0
    if not (url.startswith("https://") or (allow_http and url.startswith("http://127.0.0.1"))):
        raise ValueError("anwani si https")
    req = urllib.request.Request(url, headers={"User-Agent": "uhuru-store/" + VERSION, "Cache-Control": "no-cache"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        if not (resp.geturl().startswith("https://") or allow_http):
            raise ValueError("redirect kwenda anwani isiyo ya https")
        raw = resp.read(MAX_REMOTE + 1)
    if len(raw) > MAX_REMOTE:
        raise ValueError("katalogi ya mbali ni kubwa mno")
    data = json.loads(raw.decode("utf-8"))
    cids = {c["id"] for c in load_catalog(with_remote=False)["categories"]}
    apps, _bad = parse_remote(data, cids)  # inatupa ikiwa muundo si sahihi: akiba ya zamani inabaki
    path = _remote_cache_path()
    try:
        with open(path, "rb") as fh:
            old = fh.read()
    except OSError:
        old = None
    if old != raw:
        _write_atomic(path, raw)
    return old != raw, len(apps)


def validate(cat):
    """Inarudisha (idadi ya apt, idadi ya pwa) au inatupa ValueError."""
    cids = {c["id"] for c in cat["categories"]}
    seen, pk, pw = set(), 0, 0
    for a in cat["apps"]:
        for key in ("id", "type", "name", "summary", "category"):
            if not a.get(key):
                raise ValueError("app bila '%s': %r" % (key, a.get("id")))
        if a["id"] in seen:
            raise ValueError("id imerudiwa: " + a["id"])
        seen.add(a["id"])
        if a["category"] not in cids:
            raise ValueError("kundi lisilojulikana: %s (%s)" % (a["category"], a["id"]))
        if a["type"] == "apt":
            if not a.get("package"):
                raise ValueError("apt bila 'package': " + a["id"])
            pk += 1
        elif a["type"] == "pwa":
            if "url" not in a:
                raise ValueError("pwa bila 'url': " + a["id"])
            icon = a.get("icon", "")
            if icon and not os.path.isfile(os.path.join(ICON_DIR, icon + ".svg")):
                raise ValueError("icon haipo: %s.svg (%s)" % (icon, a["id"]))
            pw += 1
        else:
            raise ValueError("aina isiyojulikana: %s (%s)" % (a["type"], a["id"]))
    if pk < 10 or pw < 1:
        raise ValueError("orodha ni ndogo mno (apt=%d pwa=%d)" % (pk, pw))
    return pk, pw


# ------------------------------------------------------------------ hali ya programu


def apt_installed(packages):
    """Seti ya vifurushi vilivyosakinishwa (dpkg-query, bila mtandao)."""
    pkgs = sorted(set(p for p in packages if p))
    if not pkgs or not shutil.which("dpkg-query"):
        return set()
    try:
        out = subprocess.run(["dpkg-query", "-W", "-f", "${Package} ${db:Status-Abbrev}\n"] + pkgs,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             universal_newlines=True, timeout=30).stdout
    except Exception:
        return set()
    done = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1].startswith("ii"):
            done.add(parts[0])
    return done


def pwa_path(app):
    return os.path.join(APPS_DIR, "lgt-%s.desktop" % app["id"])


def pwa_ready(app):
    return bool(app.get("url"))


def pwa_installed(app):
    return os.path.isfile(pwa_path(app))


def find_browser():
    for name in ("chromium", "chromium-browser", "google-chrome"):
        path = shutil.which(name)
        if path:
            return os.path.basename(path)
    return None


def _dq(text):
    """Hoja moja ya Exec ndani ya nukuu mbili (kanuni za .desktop): inakataa herufi hatari."""
    if any(c in text for c in '\\"`$') or not _ctl_free(text):
        raise RuntimeError("herufi zisizoruhusiwa kwenye Exec: %r" % text[:40])
    return '"%s"' % text.replace("%", "%%")


def _oneline(text):
    return "".join(c for c in str(text) if ord(c) >= 32 and ord(c) != 127).strip()


def pwa_data_dir(app):
    return os.path.join(PWA_DATA, app["id"])


def pwa_icon_path(app):
    """Njia ya ikoni: PNG ya mbali (inanakiliwa kwa mtumiaji), au SVG ya ISO, au jina la ikoni ya mfumo."""
    src = app.get("icon_file", "")
    if src and os.path.isfile(src):
        os.makedirs(USER_ICON_DIR, exist_ok=True)
        dst = os.path.join(USER_ICON_DIR, "lgt-%s.png" % app["id"])
        shutil.copyfile(src, dst)
        return dst
    svg = os.path.join(ICON_DIR, app.get("icon", "") + ".svg")
    return svg if app.get("icon") and os.path.isfile(svg) else "applications-internet"


def pwa_desktop_text(app, browser, icon=None):
    """Programu ya wavuti inayofunguka kwenye dirisha lake (--app), na profile yake (--user-data-dir): haichanganyiki
    na browser ya kawaida, ina WM_CLASS yake (lgt-<id>) kwa taskbar, na ina data yake mwenyewe (login, cache)."""
    icon = icon if icon is not None else pwa_icon_path(app)
    wm = "lgt-" + app["id"]
    exec_line = " ".join([browser, _dq("--app=" + app["url"]), "--class=" + wm,
                          _dq("--user-data-dir=" + pwa_data_dir(app)), "--no-first-run", "--no-default-browser-check"])
    lines = [
        "[Desktop Entry]", "Version=1.0", "Type=Application",
        "Name=" + _oneline(app["name"]), "Comment=" + _oneline(app["summary"]),
        "Exec=" + exec_line, "Icon=" + icon, "Terminal=false", "StartupNotify=false",
        "Categories=Network;Office;", "StartupWMClass=" + wm, "X-LGT-Store=true",
        "X-LGT-Source=" + ("vendor" if app.get("source") == "vendor" else "builtin"), "",
    ]
    return "\n".join(lines)


def pwa_install(app, browser=None):
    if not pwa_ready(app):
        raise RuntimeError("Anwani (URL) ya programu hii bado haijawekwa.")
    browser = browser or find_browser()
    if not browser:
        raise RuntimeError("Chromium haijasakinishwa; haiwezi kuunda programu ya wavuti.")
    os.makedirs(APPS_DIR, exist_ok=True)
    path = pwa_path(app)
    text = pwa_desktop_text(app, browser)
    with open(path + ".part", "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(path + ".part", 0o755)
    os.replace(path + ".part", path)
    _refresh_desktop_db()


def pwa_remove(app):
    """Inaondoa njia ya mkato na ikoni; data ya programu (login) inabaki ili kusakinisha tena kusiwe na usumbufu."""
    for path in (pwa_path(app), os.path.join(USER_ICON_DIR, "lgt-%s.png" % app["id"])):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    _refresh_desktop_db()


def pwa_upgrade_installed(apps):
    """Njia za mkato za awamu ya 4 (bila profile yake) zinasasishwa kimya kimya kuwa muundo mpya."""
    for app in apps:
        if app.get("type") != "pwa" or not pwa_installed(app):
            continue
        try:
            with open(pwa_path(app), "r", encoding="utf-8") as fh:
                text = fh.read()
            if "X-LGT-Store=true" in text and "--user-data-dir=" not in text:
                pwa_install(app)
        except Exception as exc:
            sys.stderr.write("pwa-upgrade: %s: %s\n" % (app.get("id"), exc))


def _refresh_desktop_db():
    exe = shutil.which("update-desktop-database")
    if exe:
        try:
            subprocess.run([exe, APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        except Exception:
            pass


def run_privileged(argv, on_line=None):
    """Endesha amri kama root (pkexec). Inarudisha (msimbo, mistari-ya-mwisho)."""
    cmd = ["env", "DEBIAN_FRONTEND=noninteractive", "LC_ALL=C"] + argv
    if os.geteuid() != 0:
        cmd = ["pkexec"] + cmd
    tail = []
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
    except OSError as exc:
        return 127, [str(exc)]
    for line in proc.stdout:
        line = line.rstrip()
        if line:
            tail = (tail + [line])[-8:]
            if on_line:
                on_line(line)
    return proc.wait(), tail


def explain_failure(rc, tail):
    if rc in (126, 127) and os.geteuid() != 0:
        return "Umeghairi au huna ruhusa ya msimamizi (password si sahihi)."
    text = " ".join(tail).lower()
    if "could not resolve" in text or "temporary failure" in text or "failed to fetch" in text or "unable to connect" in text:
        return "Hakuna mtandao. Unganisha mtandao kisha ujaribu tena."
    if "unable to locate package" in text or "has no installation candidate" in text:
        return "Kifurushi hakipatikani. Jaribu \"Sasisha orodha\" ukiwa na mtandao."
    return "Imeshindikana (msimbo %s).\n%s" % (rc, "\n".join(tail[-3:]))


# ------------------------------------------------------------------ amri za CLI


def cmd_check():
    try:
        pk, pw = validate(load_catalog())
    except Exception as exc:
        print("CHECK-FAIL catalog %s" % str(exc).replace(" ", "_")[:60])
        return 1
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk  # noqa: F401
    except Exception as exc:
        if os.environ.get("UHURU_STORE_NOGTK") != "1":
            print("CHECK-FAIL gtk %s" % str(exc).replace(" ", "_")[:60])
            return 1
    print("CHECK-OK pkgs=%d pwa=%d" % (pk, pw))
    return 0


def _tiny_png():
    import struct
    import zlib

    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
    raw = b"\x00\xf5\xc5\x18\xff"
    return (PNG_MAGIC + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


def _app_by_id(app_id):
    for a in load_catalog()["apps"]:
        if a["id"] == app_id:
            return a
    return None


def cmd_pwa(argv, install):
    flag = "--install-pwa" if install else "--remove-pwa"
    i = argv.index(flag)
    app = _app_by_id(argv[i + 1]) if i + 1 < len(argv) else None
    if app is None or app["type"] != "pwa":
        print("PWA-FAIL haipo")
        return 1
    try:
        (pwa_install if install else pwa_remove)(app)
    except Exception as exc:
        print("PWA-FAIL %s" % str(exc).replace(" ", "_")[:60])
        return 1
    print("PWA-OK %s %s" % ("installed" if install else "removed", app["id"]))
    return 0


def cmd_sync():
    try:
        changed, n = fetch_remote()
    except urllib.error.HTTPError as exc:
        print("SYNC-FAIL http_%s" % exc.code)
        return 1
    except urllib.error.URLError:
        print("SYNC-FAIL offline")
        return 1
    except Exception as exc:
        print("SYNC-FAIL %s" % type(exc).__name__)
        return 1
    if remote_url() is None:
        print("SYNC-NOURL")
        return 0
    print("SYNC-OK changed=%d apps=%d" % (changed, n))
    return 0


def cmd_p6check():
    """Jaribio kamili la ndani (bila skrini, bila mtandao wa nje): katalogi ya mbali, ukaguzi wa usalama, na njia za mkato za PWA."""
    import configparser
    import http.server
    import tempfile
    import urllib.error  # noqa: F401
    g = globals()
    keys = ("CACHE_DIR", "APPS_DIR", "PWA_DATA", "USER_ICON_DIR", "REMOTE_CONF", "USER_REMOTE_CONF")
    saved = {k: g[k] for k in keys}
    tmp = tempfile.mkdtemp(prefix="uhuru-p6-")
    step = "init"
    srv = None
    try:
        g.update(CACHE_DIR=tmp + "/cache", APPS_DIR=tmp + "/apps", PWA_DATA=tmp + "/pwa", USER_ICON_DIR=tmp + "/icons",
                 REMOTE_CONF=tmp + "/none.json", USER_REMOTE_CONF=tmp + "/none2.json")
        step = "builtin"
        base = load_catalog()
        validate(base)
        ids = {a["id"]: a for a in base["apps"]}
        if not ({"tracetz", "letema-web"} <= set(ids)):
            raise ValueError("bidhaa mbili za Letema hazipo")
        uri = "data:image/png;base64," + base64.b64encode(_tiny_png()).decode()
        full = dict(type="pwa", category="letema", summary="Maelezo", priority=5)
        remote = {"format": 1, "apps": [
            dict(full, id="demo-pos", name="Demo POS", url="https://pos.example.co.tz/app?x=1&y=2", icon_png=uri),
            dict(full, id="demo-school", name="Demo Shule", url="https://shule.example.co.tz", category="education"),
            dict(full, id="tracetz", name="TraceTZ Hub", summary="Imesasishwa kwa mbali", url="https://www.tracetzhub.lsicbusiness.online"),
            dict(full, id="demo-hidden", name="Imefichwa", url="https://hidden.example.co.tz", enabled=False),
            dict(full, id="thunderbird", name="Feki", url="https://evil.example.com"),
            dict(full, id="bad-apt", type="apt", name="X", url="https://x.example.com"),
            dict(full, id="bad-http", name="X", url="http://x.example.com"),
            dict(full, id="Bad Id", name="X", url="https://x.example.com"),
            dict(full, id="bad-name", name="Mstari\nmpya", url="https://x.example.com"),
            dict(full, id="bad-cat", name="X", url="https://x.example.com", category="nope"),
            dict(full, id="bad-quote", name="X", url='https://x.example.com/"; rm -rf ~'),
            dict(full, id="bad-user", name="X", url="https://user@x.example.com@evil.com/"),
            dict(full, id="bad-icon", name="X", url="https://x.example.com", icon_png="data:image/svg+xml;base64,PHN2Zz4="),
            dict(full, id="bad-png", name="X", url="https://x.example.com", icon_png="data:image/png;base64,AAAA"),
        ]}
        body = json.dumps(remote).encode()
        state = {"body": body, "code": 200}

        class H(http.server.BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def do_GET(self):
                self.send_response(state["code"])
                self.send_header("Content-Length", str(len(state["body"])))
                self.end_headers()
                self.wfile.write(state["body"])
        srv = http.server.HTTPServer(("127.0.0.1", 0), H)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        url = "http://127.0.0.1:%d/catalog.json" % srv.server_address[1]

        step = "fetch"
        changed, n = fetch_remote(url, allow_http=True)
        if not changed or n != 5:
            raise ValueError("halali=%s (inatakiwa 5)" % n)
        if fetch_remote(url, allow_http=True)[0]:
            raise ValueError("fetch ya pili haipaswi kubadilika")
        cids = {c["id"] for c in base["categories"]}
        _good, bad = parse_remote(remote, cids)
        if len(bad) != 9:
            raise ValueError("zilizokataliwa=%d (inatakiwa 9)" % len(bad))
        step = "merge"
        merged = load_catalog()
        mi = {a["id"]: a for a in merged["apps"]}
        if "demo-pos" not in mi or "demo-school" not in mi:
            raise ValueError("bidhaa halali hazikuingia")
        if not os.path.isfile(mi["demo-pos"].get("icon_file", "")):
            raise ValueError("ikoni haikuandikwa")
        if mi["tracetz"]["summary"] != "Imesasishwa kwa mbali" or mi["tracetz"].get("icon") != "lgt-tracetz":
            raise ValueError("override ya PWA ya ISO imeshindwa")
        if "demo-hidden" in mi or mi["thunderbird"]["type"] != "apt" or any(k.startswith("bad-") for k in mi):
            raise ValueError("kiingilio batili kimepita")
        validate(merged)
        step = "offline"
        state["code"] = 404
        try:
            fetch_remote(url, allow_http=True)
            raise ValueError("404 ilipaswa kushindwa")
        except urllib.error.HTTPError:
            pass
        state["code"], state["body"] = 200, b"{not json"
        try:
            fetch_remote(url, allow_http=True)
            raise ValueError("JSON mbovu ilipaswa kushindwa")
        except ValueError as exc:
            if "ilipaswa" in str(exc):
                raise
        if "demo-pos" not in {a["id"]: a for a in load_catalog()["apps"]}:
            raise ValueError("akiba ya zamani ilipotea baada ya kushindwa")
        step = "desktop"
        done = 0
        for app in merged["apps"]:
            if app["type"] != "pwa":
                continue
            pwa_install(app, browser="chromium")
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            cp.optionxform = str
            cp.read(pwa_path(app), encoding="utf-8")
            ent = cp["Desktop Entry"]
            argv = shlex.split(ent["Exec"].replace("%%", "%"))
            want = "lgt-" + app["id"]
            if (argv[0] != "chromium" or argv[1] != "--app=" + app["url"] or "--class=" + want not in argv
                    or "--user-data-dir=" + pwa_data_dir(app) not in argv):
                raise ValueError("Exec si sahihi: %s" % app["id"])
            if ent["StartupWMClass"] != want or ent["Terminal"] != "false" or ent["Name"] != app["name"]:
                raise ValueError("sehemu za .desktop si sahihi: %s" % app["id"])
            if os.path.isabs(ent["Icon"]) and not os.path.isfile(ent["Icon"]):
                raise ValueError("ikoni haipo: %s" % app["id"])
            done += 1
        if done < 4:
            raise ValueError("PWA zilizojaribiwa=%d" % done)
        if not os.path.isfile(os.path.join(tmp, "icons", "lgt-demo-pos.png")):
            raise ValueError("ikoni ya mtumiaji haikunakiliwa")
        pwa_remove(mi["demo-pos"])
        if pwa_installed(mi["demo-pos"]) or os.path.isfile(os.path.join(tmp, "icons", "lgt-demo-pos.png")):
            raise ValueError("pwa_remove imeshindwa")
        print("P6-OK apps=%d vendor=2 rejected=%d fetch=ok merge=ok desktop=%d security=ok browser=%s"
              % (len(merged["apps"]), len(bad), done, "yes" if find_browser() else "no"))
        return 0
    except Exception as exc:
        print("P6-FAIL step=%s %s" % (step, str(exc).replace(" ", "_")[:60]))
        return 1
    finally:
        if srv is not None:
            srv.shutdown()
            srv.server_close()
        g.update(saved)
        shutil.rmtree(tmp, ignore_errors=True)


def main(argv):
    if "--check" in argv:
        return cmd_check()
    if "--p6-check" in argv:
        return cmd_p6check()
    if "--sync" in argv:
        return cmd_sync()
    if "--install-pwa" in argv:
        return cmd_pwa(argv, True)
    if "--remove-pwa" in argv:
        return cmd_pwa(argv, False)
    smoke = "--smoke" in argv
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gtk, Gdk, GLib, Pango, GdkPixbuf, Gio
    except Exception as exc:
        print("SMOKE-FAIL import %s" % str(exc).replace(" ", "_")[:60])
        return 1
    if Gdk.Display.get_default() is None:
        print("SMOKE-FAIL no-display" if smoke else "uhuru-store: hakuna skrini (DISPLAY)")
        return 1
    GLib.set_prgname("uhuru-store")
    GLib.set_application_name("LGT Store")
    try:
        ui = build_ui_classes(Gtk, Gdk, GLib, Pango, GdkPixbuf, Gio)
        catalog = load_catalog()
        pwa_upgrade_installed(catalog["apps"])
        win = ui["StoreWindow"](catalog)
        if smoke:
            win.get_child().show_all()
            win.realize()
            for _ in range(60):
                if not Gtk.events_pending():
                    break
                Gtk.main_iteration()
            print("SMOKE-OK cards=%d" % win.card_count())
            win.destroy()
            return 0
        win.connect("destroy", Gtk.main_quit)
        win.show_all()
        win.refresh_filter()
        win.start_remote_sync()
        Gtk.main()
        return 0
    except Exception as exc:
        import traceback
        if smoke:
            traceback.print_exc(file=sys.stderr)
            print("SMOKE-FAIL %s" % (type(exc).__name__ + ":" + str(exc)).replace(" ", "_")[:70])
            return 1
        raise


# ------------------------------------------------------------------ GUI


def build_ui_classes(Gtk, Gdk, GLib, Pango, GdkPixbuf, Gio):

    def theme_has(name):
        theme = Gtk.IconTheme.get_default()
        return bool(name) and theme.has_icon(name)

    def make_icon(app, fallback, size):
        img = Gtk.Image()
        ifile = app.get("icon_file", "")
        if ifile and os.path.isfile(ifile):
            try:
                img.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(ifile, size, size))
                return img
            except Exception:
                pass
        name = app.get("icon", "")
        svg = os.path.join(ICON_DIR, name + ".svg")
        if name and os.path.isfile(svg):
            try:
                img.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(svg, size, size))
                return img
            except Exception:
                pass
        if theme_has(name):
            img.set_from_icon_name(name, Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name(fallback or "package-x-generic", Gtk.IconSize.DIALOG)
        img.set_pixel_size(size)
        return img

    class Card(Gtk.Box):
        def __init__(self, win, app, fallback_icon, letema):
            Gtk.Box.__init__(self, orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.win, self.app = win, app
            self.get_style_context().add_class("lgt-card")
            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            top.pack_start(make_icon(app, fallback_icon, 56), False, False, 0)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            name = Gtk.Label(label=app["name"])
            name.set_xalign(0)
            name.set_ellipsize(Pango.EllipsizeMode.END)
            name.get_style_context().add_class("lgt-card-title")
            badge_text = "Letema" if letema else ("PWA" if app["type"] == "pwa" else "Debian")
            badge = Gtk.Label(label=badge_text)
            badge.set_xalign(0)
            badge.set_halign(Gtk.Align.START)
            badge.get_style_context().add_class("lgt-badge-letema" if letema else "lgt-badge")
            txt.pack_start(name, False, False, 0)
            txt.pack_start(badge, False, False, 0)
            top.pack_start(txt, True, True, 0)
            self.pack_start(top, False, False, 0)
            desc = Gtk.Label(label=app["summary"])
            desc.set_xalign(0)
            desc.set_yalign(0)
            desc.set_line_wrap(True)
            desc.set_max_width_chars(30)
            desc.set_size_request(-1, 58)
            desc.get_style_context().add_class("lgt-card-desc")
            self.pack_start(desc, True, True, 0)
            bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            self.btn = Gtk.Button(label="Sakinisha")
            self.btn.connect("clicked", self.on_main)
            self.rm = Gtk.Button(label="Ondoa")
            self.rm.get_style_context().add_class("lgt-remove")
            self.rm.connect("clicked", self.on_remove)
            self.rm.set_no_show_all(True)
            self.spin = Gtk.Spinner()
            self.spin.set_no_show_all(True)
            self.status = Gtk.Label(label="")
            self.status.set_xalign(0)
            self.status.set_ellipsize(Pango.EllipsizeMode.END)
            self.status.get_style_context().add_class("lgt-status")
            bottom.pack_start(self.btn, False, False, 0)
            bottom.pack_start(self.rm, False, False, 0)
            bottom.pack_start(self.spin, False, False, 0)
            bottom.pack_start(self.status, True, True, 0)
            self.pack_start(bottom, False, False, 0)
            self.busy = False
            self.state = "available"

        def set_state(self, state):
            self.state = state
            ctx = self.btn.get_style_context()
            for cls in ("lgt-install", "lgt-open", "lgt-soon"):
                ctx.remove_class(cls)
            self.btn.set_sensitive(not self.busy)
            self.rm.set_visible(state == "installed" and not self.busy)
            if state == "installed":
                self.btn.set_label("Fungua")
                ctx.add_class("lgt-open")
            elif state == "soon":
                self.btn.set_label("Inakuja hivi karibuni")
                ctx.add_class("lgt-soon")
                self.btn.set_sensitive(False)
            else:
                self.btn.set_label("Sakinisha")
                ctx.add_class("lgt-install")

        def set_busy(self, busy, text=""):
            self.busy = busy
            self.btn.set_sensitive(not busy and self.state != "soon")
            self.rm.set_sensitive(not busy)
            if busy:
                self.spin.show()
                self.spin.start()
            else:
                self.spin.stop()
                self.spin.hide()
            self.status.set_text(text)

        def set_status(self, text):
            self.status.set_text(text[:70])

        def on_main(self, _btn):
            if self.state == "installed":
                self.win.launch(self.app)
            elif self.state == "available":
                self.win.install(self, self.app)

        def on_remove(self, _btn):
            self.win.remove(self, self.app)

    class StoreWindow(Gtk.Window):
        def __init__(self, catalog):
            Gtk.Window.__init__(self, title="LGT Store")
            self.catalog = catalog
            self.cats = {c["id"]: c for c in catalog["categories"]}
            self.cat_id = "all"
            self.query = ""
            self.cards = []
            self.apt_done = set()
            self.set_default_size(1060, 700)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.get_style_context().add_class("lgt-store")
            icon = os.path.join(ICON_DIR, "uhuru-store.svg")
            if os.path.isfile(icon):
                try:
                    self.set_icon_from_file(icon)
                except Exception:
                    pass
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS.encode("utf-8"))
            screen = Gdk.Screen.get_default()
            if screen is not None:
                Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self._build()
            self.reload_state()

        # ---- ujenzi
        def _build(self):
            hb = Gtk.HeaderBar()
            hb.set_show_close_button(True)
            hb.get_style_context().add_class("lgt-header")
            hb.set_title("LGT Store")
            hb.set_subtitle("Duka la Programu \u2022 Uhuru OS")
            self.search = Gtk.SearchEntry()
            self.search.set_placeholder_text("Tafuta programu\u2026")
            self.search.set_width_chars(36)
            self.search.connect("search-changed", self.on_search)
            hb.set_custom_title(self.search)
            refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
            refresh.set_tooltip_text("Sasisha orodha ya programu (inahitaji mtandao)")
            refresh.connect("clicked", self.on_update_lists)
            hb.pack_end(refresh)
            self.set_titlebar(hb)

            root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            self.add(root)

            side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            side.get_style_context().add_class("lgt-sidebar")
            side.set_size_request(236, -1)
            logo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            logo.set_margin_top(22)
            logo.set_margin_bottom(16)
            logo.set_margin_start(24)
            l1 = Gtk.Label(label="LGT Store")
            l1.set_xalign(0)
            l1.get_style_context().add_class("lgt-logo")
            l2 = Gtk.Label(label="Letema Group Tech")
            l2.set_xalign(0)
            l2.get_style_context().add_class("lgt-logo-sub")
            logo.pack_start(l1, False, False, 0)
            logo.pack_start(l2, False, False, 0)
            side.pack_start(logo, False, False, 0)
            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.listbox.get_style_context().add_class("lgt-sidebar")
            self.rows = {}
            entries = [("all", "Zote", "view-grid-symbolic")]
            for c in self.catalog["categories"]:
                entries.append((c["id"], c["name"], c.get("icon", "folder-symbolic")))
            entries.append(("installed", "Zilizosakinishwa", "object-select-symbolic"))
            for cid, label, icon in entries:
                row = Gtk.ListBoxRow()
                box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON), False, False, 0)
                lab = Gtk.Label(label=label)
                lab.set_xalign(0)
                lab.set_ellipsize(Pango.EllipsizeMode.END)
                box.pack_start(lab, True, True, 0)
                row.add(box)
                row.cat_id = cid
                self.listbox.add(row)
                self.rows[cid] = row
            self.listbox.connect("row-selected", self.on_category)
            side_scroll = Gtk.ScrolledWindow()
            side_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            side_scroll.add(self.listbox)
            side.pack_start(side_scroll, True, True, 0)
            ver = Gtk.Label(label="Uhuru OS \u2022 toleo %s" % VERSION)
            ver.get_style_context().add_class("lgt-logo-sub")
            ver.set_margin_bottom(14)
            side.pack_start(ver, False, False, 0)
            root.pack_start(side, False, False, 0)

            main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
            main.set_margin_top(22)
            main.set_margin_bottom(22)
            main.set_margin_start(26)
            main.set_margin_end(26)
            self.hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            self.hero.get_style_context().add_class("lgt-hero")
            self.hero_title = Gtk.Label(label="")
            self.hero_title.set_xalign(0)
            self.hero_title.get_style_context().add_class("lgt-hero-title")
            self.hero_sub = Gtk.Label(label="")
            self.hero_sub.set_xalign(0)
            self.hero_sub.set_line_wrap(True)
            self.hero_sub.get_style_context().add_class("lgt-hero-sub")
            self.hero.pack_start(self.hero_title, False, False, 0)
            self.hero.pack_start(self.hero_sub, False, False, 0)
            main.pack_start(self.hero, False, False, 0)

            self.flow = Gtk.FlowBox()
            self.flow.set_valign(Gtk.Align.START)
            self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
            self.flow.set_homogeneous(True)
            self.flow.set_min_children_per_line(1)
            self.flow.set_max_children_per_line(4)
            self.flow.set_column_spacing(16)
            self.flow.set_row_spacing(16)
            self.flow.set_filter_func(self._filter)
            self.flow.set_sort_func(self._sort)
            self.empty = Gtk.Label(label="Hakuna programu zilizopatikana.")
            self.empty.get_style_context().add_class("lgt-empty")
            self.empty.set_no_show_all(True)
            holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            holder.pack_start(self.flow, False, False, 0)
            holder.pack_start(self.empty, False, False, 24)
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.add(holder)
            main.pack_start(scroll, True, True, 0)
            root.pack_start(main, True, True, 0)

            self._add_cards()
            self.listbox.select_row(self.rows["all"])

        def _add_cards(self):
            for app in self.catalog["apps"]:
                cat = self.cats.get(app["category"], {})
                card = Card(self, app, cat.get("fallback_icon", "package-x-generic"), app["category"] == "letema")
                self.cards.append(card)
                self.flow.add(card)

        def apply_remote(self):
            """Bidhaa mpya kutoka Vendor Console zinaonekana mara moja, bila kufunga duka."""
            try:
                cat = load_catalog()
            except Exception:
                return False
            self.catalog = cat
            self.cats = {c["id"]: c for c in cat["categories"]}
            for child in list(self.flow.get_children()):
                self.flow.remove(child)
            self.cards = []
            self._add_cards()
            self.flow.show_all()
            self.reload_state()
            return False

        def start_remote_sync(self):
            def worker():
                try:
                    changed, _n = fetch_remote()
                except Exception as exc:  # hakuna mtandao au URL haipo: akiba inatumika
                    sys.stderr.write("remote-sync: %s\n" % exc)
                    return
                if changed:
                    GLib.idle_add(self.apply_remote)
            threading.Thread(target=worker, daemon=True).start()

        # ---- hali
        def reload_state(self):
            self.apt_done = apt_installed([c.app.get("package") for c in self.cards if c.app["type"] == "apt"])
            for card in self.cards:
                card.set_state(self.state_of(card.app))
            self.refresh_filter()

        def state_of(self, app):
            if app["type"] == "pwa":
                if pwa_installed(app):
                    return "installed"
                return "available" if pwa_ready(app) else "soon"
            return "installed" if app["package"] in self.apt_done else "available"

        def card_count(self):
            return len(self.cards)

        # ---- kuchuja
        def matches(self, card):
            app = card.app
            q = self.query
            if q:
                hay = " ".join([app["name"], app["summary"], app.get("keywords", ""), app.get("package", "")]).lower()
                if q not in hay:
                    return False
            if self.cat_id == "all":
                return True
            if self.cat_id == "installed":
                return card.state == "installed"
            return app["category"] == self.cat_id

        def _filter(self, child):
            return self.matches(child.get_child())

        def _sort(self, a, b):
            ca, cb = a.get_child().app, b.get_child().app
            ka = (0 if ca["category"] == "letema" else 1, ca.get("priority", 100), ca["name"].lower())
            kb = (0 if cb["category"] == "letema" else 1, cb.get("priority", 100), cb["name"].lower())
            return (ka > kb) - (ka < kb)

        def refresh_filter(self):
            self.flow.invalidate_filter()
            self.flow.invalidate_sort()
            shown = sum(1 for c in self.cards if self.matches(c))
            self.empty.set_visible(shown == 0)
            if shown == 0:
                self.empty.show()
            if self.cat_id == "all":
                self.hero_title.set_text("Karibu LGT Store")
                self.hero_sub.set_text("Pata programu na bidhaa za Letema Group Tech kwa click moja \u2014 bila kuhangaika.")
            elif self.cat_id == "installed":
                self.hero_title.set_text("Zilizosakinishwa")
                self.hero_sub.set_text("Programu ulizosakinisha kupitia duka hili.")
            else:
                cat = self.cats.get(self.cat_id, {})
                self.hero_title.set_text(cat.get("name", ""))
                self.hero_sub.set_text(cat.get("desc", ""))

        def on_search(self, entry):
            self.query = entry.get_text().strip().lower()
            self.refresh_filter()

        def on_category(self, _lb, row):
            if row is not None:
                self.cat_id = row.cat_id
                self.refresh_filter()

        # ---- vitendo
        def message(self, kind, text, secondary=""):
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                    buttons=Gtk.ButtonsType.CLOSE, text=text)
            if secondary:
                dlg.format_secondary_text(secondary)
            dlg.run()
            dlg.destroy()

        def launch(self, app):
            try:
                if app["type"] == "pwa":
                    info = Gio.DesktopAppInfo.new_from_filename(pwa_path(app))
                else:
                    info = Gio.DesktopAppInfo.new(app.get("desktop", app["package"] + ".desktop"))
                if info is None:
                    raise RuntimeError("Faili ya programu haipatikani.")
                info.launch([], None)
            except Exception as exc:
                self.message(Gtk.MessageType.ERROR, "Imeshindikana kufungua %s" % app["name"], str(exc))

        def install(self, card, app):
            if app["type"] == "pwa":
                try:
                    pwa_install(app)
                except Exception as exc:
                    self.message(Gtk.MessageType.ERROR, "Imeshindikana kusakinisha %s" % app["name"], str(exc))
                self.reload_state()
                return
            self._run(card, ["apt-get", "install", "-y", app["package"]], "Inasakinisha\u2026")

        def remove(self, card, app):
            if app["type"] == "pwa":
                pwa_remove(app)
                self.reload_state()
                return
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    buttons=Gtk.ButtonsType.YES_NO, text="Ondoa %s?" % app["name"])
            dlg.format_secondary_text("Programu itaondolewa kwenye kompyuta hii.")
            resp = dlg.run()
            dlg.destroy()
            if resp == Gtk.ResponseType.YES:
                self._run(card, ["apt-get", "remove", "-y", app["package"]], "Inaondoa\u2026")

        def on_update_lists(self, _btn):
            for card in self.cards:
                card.set_busy(True, "Inasasisha orodha\u2026")

            def worker():
                try:  # bidhaa za Letema (Vendor Console) hazihitaji ruhusa ya msimamizi
                    if fetch_remote()[0]:
                        GLib.idle_add(self.apply_remote)
                except Exception as exc:
                    sys.stderr.write("remote-sync: %s\n" % exc)
                rc, tail = run_privileged(["apt-get", "update"])
                GLib.idle_add(self._lists_done, rc, tail)
            threading.Thread(target=worker, daemon=True).start()

        def _lists_done(self, rc, tail):
            for card in self.cards:
                card.set_busy(False, "")
            self.reload_state()
            if rc != 0:
                self.message(Gtk.MessageType.ERROR, "Imeshindikana kusasisha orodha", explain_failure(rc, tail))
            return False

        def _run(self, card, argv, text):
            card.set_busy(True, text)

            def worker():
                rc, tail = run_privileged(argv, lambda line: GLib.idle_add(card.set_status, line))
                GLib.idle_add(self._op_done, card, rc, tail)
            threading.Thread(target=worker, daemon=True).start()

        def _op_done(self, card, rc, tail):
            card.set_busy(False, "")
            self.reload_state()
            if rc != 0:
                self.message(Gtk.MessageType.ERROR, "Imeshindikana: %s" % card.app["name"], explain_failure(rc, tail))
            return False

    return {"Card": Card, "StoreWindow": StoreWindow}


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
