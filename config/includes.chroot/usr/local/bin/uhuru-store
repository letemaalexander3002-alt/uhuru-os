#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""LGT Store - Duka la Programu la Uhuru OS (Letema Group Tech).

  uhuru-store            fungua duka
  uhuru-store --check    kagua orodha ya programu na GTK (haihitaji skrini)
  uhuru-store --smoke    jenga dirisha bila kulionyesha (kwa CI)
  uhuru-store --sync     pakua bidhaa mpya za PWA kutoka Vendor Console (akiba inafanya kazi bila mtandao)
  uhuru-store --install-pwa ID | --remove-pwa ID    sakinisha/ondoa programu ya wavuti
  uhuru-store --p6-check jaribio la ndani la katalogi ya mbali na njia za mkato za PWA (kwa CI)
"""
import base64
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import urllib.error
import urllib.request

VERSION = "1.0"
SHARE = os.environ.get("UHURU_STORE_SHARE", "/usr/share/uhuru-store")
CATALOG_D = os.environ.get("UHURU_STORE_CATALOG_D", "/etc/uhuru-store/catalog.d")
APPS_DIR = os.environ.get("UHURU_STORE_APPS_DIR",
                          os.path.join(os.path.expanduser("~"), ".local", "share", "applications"))
ICON_DIR = os.path.join(SHARE, "icons")
_HOME = os.path.expanduser("~")
CACHE_DIR = os.environ.get("UHURU_STORE_CACHE", os.path.join(_HOME, ".cache", "uhuru-store"))
REMOTE_CONF = os.environ.get("UHURU_STORE_REMOTE_CONF", "/etc/uhuru-store/remote.json")
USER_REMOTE_CONF = os.path.join(_HOME, ".config", "uhuru-store", "remote.json")
PWA_DATA = os.environ.get("UHURU_STORE_PWA_DATA", os.path.join(_HOME, ".local", "share", "uhuru-pwa"))
USER_ICON_DIR = os.environ.get("UHURU_STORE_USER_ICONS", os.path.join(_HOME, ".local", "share", "uhuru-store", "icons"))

# ---- katalogi ya mbali (Vendor Console): bidhaa za PWA pekee, zinakaguliwa kwa ukali kabla ya kutumika
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,40}$")
URL_RE = re.compile(r"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~:/?#\[\]@!&()*+,;=%-]*)?$")
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
MAX_REMOTE = 2 * 1024 * 1024
MAX_ICON = 150 * 1024
MAX_REMOTE_APPS = 60

CSS = """
