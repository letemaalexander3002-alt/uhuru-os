#!/bin/sh
# Uhuru OS — Awamu ya 3: branding kamili + credit ya Letema Group Tech (v11)
set -e

THEME=/usr/share/plymouth/themes/uhuru-os/uhuru-os.plymouth
LOGO=/usr/share/icons/hicolor/512x512/apps/uhuru-os-logo.png
SITE=https://www.letemagrouptech.lsicbusiness.online

# 1. Plymouth: theme ya Uhuru kama chaguo-msingi, kisha usasishe initramfs
if [ -f "$THEME" ]; then
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme uhuru-os
    elif command -v update-alternatives >/dev/null 2>&1; then
        update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$THEME" 100
        update-alternatives --set default.plymouth "$THEME"
    fi
    ln -sf "$THEME" /usr/share/plymouth/themes/default.plymouth
    command -v update-initramfs >/dev/null 2>&1 && update-initramfs -u
else
    echo "WARNING: theme ya uhuru-os haipo: $THEME" >&2
fi

# 2. Hostname ya mfumo
echo "uhuru-os" > /etc/hostname
if grep -q "^127\.0\.1\.1" /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tuhuru-os/' /etc/hosts
else
    printf '127.0.1.1\tuhuru-os\n' >> /etc/hosts
fi

# 3. Hostname chaguo-msingi ya live-config
if [ -f /usr/lib/live/config/0020-hostname ]; then
    sed -i 's/debian/uhuru-os/g' /usr/lib/live/config/0020-hostname
fi

# 4. Launchers na programu za Debian
rm -f /usr/share/applications/install-debian.desktop
rm -f /usr/share/xfce4/helpers/debian-sensible-browser.desktop
rm -f /usr/share/xfce4/helpers/debian-x-terminal-emulator.desktop

# 5. Icons za emblem-debian
find /usr/share/icons -name 'emblem-debian*' -exec rm -f {} + 2>/dev/null || true

# 6. GRUB theme ya Debian
rm -f /etc/grub.d/05_debian_theme

# 7. Calamares: maandishi, URL, logo, na credit
CAL=/etc/calamares/branding/debian
if [ -d "$CAL" ]; then
    find "$CAL" -type f \( -name '*.desc' -o -name '*.qml' \) -exec sed -i \
        -e 's/Debian GNU\/Linux/Uhuru OS/g' \
        -e 's/Debian 12/Uhuru OS 1.0/g' \
        -e 's/Debian/Uhuru OS/g' \
        -e "s#https\?://[A-Za-z.]*debian\.org[^ \"<]*#$SITE#g" {} +
    if [ -f "$LOGO" ]; then
        for img in "$CAL"/*.png; do
            [ -f "$img" ] && cp "$LOGO" "$img" || true
        done
    fi
    if [ -f "$CAL/show.qml" ]; then
        sed -i 's#Welcome to Uhuru OS#Welcome to Uhuru OS - Imetengenezwa na Letema Group Tech (letemagrouptech.lsicbusiness.online)#' "$CAL/show.qml"
    fi
    if [ -f /usr/share/pixmaps/letema-logo.png ]; then
        cp /usr/share/pixmaps/letema-logo.png "$CAL/letema-logo.png"
    fi
fi

# 8. Jina kamili la mtumiaji wa live (live-config)
for f in /usr/lib/live/config/*; do
    [ -f "$f" ] && sed -i 's/Debian Live/Uhuru OS Live/g' "$f" || true
done

# 9. Maandishi yanayoonekana kwenye .desktop (Name, GenericName, Comment) kwenye menyu na xfce4
find /usr/share/applications /usr/share/xfce4 -name '*.desktop' -exec sed -i \
    '/^\(Name\|GenericName\|Comment\)/s/Debian/Uhuru OS/g' {} + 2>/dev/null || true

# 10. Jina la muuzaji kwenye xfce4 (dirisha la About)
if [ -f /usr/share/xfce4/vendorinfo ]; then
    sed -i 's/Debian/Uhuru OS/g' /usr/share/xfce4/vendorinfo
fi

# 11. Jina la mtumiaji wa live na ujumbe wa live-boot: lengo la moja kwa moja
for f in /usr/lib/live/config/init-config.sh /usr/lib/live/boot/9990-initramfs-tools.sh; do
    if [ -f "$f" ]; then
        sed -i -e 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="Uhuru OS user"/' \
               -e 's/Debian Live/Uhuru OS Live/g' "$f"
    fi
done
for f in $(find /usr/lib/live -type f 2>/dev/null); do
    if grep -q "LIVE_USER_FULLNAME=\"Debian" "$f" 2>/dev/null; then
        sed -i 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="Uhuru OS user"/' "$f"
    fi
done

echo "Plymouth default: $(readlink -f /usr/share/plymouth/themes/default.plymouth 2>/dev/null || echo haijulikani)"
echo "Uhuru OS branding hook (v11): imekamilika."
