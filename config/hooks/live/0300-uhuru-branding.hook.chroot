#!/bin/sh
# Uhuru OS — Awamu ya 3: branding kamili + credit ya Letema Group Tech (v13.1)
# v12: password ya live user = uhuru
# v13: wizard ya kujisajili (OOBE) na kufunga akaunti ya default
# v13.1: lock screen, login screen na wallpaper za Uhuru, os-release/issue/motd, GRUB, saa ya EAT,
#        Firefox, About, firewall. Hatua 12 na 14 zinasimamisha build zikifeli; zingine ni best-effort.
set -e

THEME=/usr/share/plymouth/themes/uhuru-os/uhuru-os.plymouth
LOGO=/usr/share/icons/hicolor/512x512/apps/uhuru-os-logo.png
SITE=https://www.letemagrouptech.lsicbusiness.online

# 1. Plymouth: theme ya Uhuru kama chaguo-msingi, kisha usasishe initramfs
if [ -f "$THEME" ]; then
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme uhuru-os
    elif command -v update-alternatives >/dev/null 2>&1; then
        update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$THEME" 100
        update-alternatives --set default.plymouth "$THEME"
    fi
    ln -sf "$THEME" /usr/share/plymouth/themes/default.plymouth
    command -v update-initramfs >/dev/null 2>&1 && update-initramfs -u
else
    echo "WARNING: theme ya uhuru-os haipo: $THEME" >&2
fi

# 2. Hostname ya mfumo
echo "uhuru-os" > /etc/hostname
if grep -q "^127\.0\.1\.1" /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tuhuru-os/' /etc/hosts
else
    printf '127.0.1.1\tuhuru-os\n' >> /etc/hosts
fi

# 3. Hostname chaguo-msingi ya live-config
if [ -f /usr/lib/live/config/0020-hostname ]; then
    sed -i 's/debian/uhuru-os/g' /usr/lib/live/config/0020-hostname
fi

# 4. Launchers na programu za Debian
rm -f /usr/share/applications/install-debian.desktop
rm -f /usr/share/xfce4/helpers/debian-sensible-browser.desktop
rm -f /usr/share/xfce4/helpers/debian-x-terminal-emulator.desktop

# 5. Icons za emblem-debian
find /usr/share/icons -name 'emblem-debian*' -exec rm -f {} + 2>/dev/null || true

# 6. GRUB theme ya Debian
rm -f /etc/grub.d/05_debian_theme

# 7. Calamares: maandishi, URL, logo, na credit
CAL=/etc/calamares/branding/debian
if [ -d "$CAL" ]; then
    find "$CAL" -type f \( -name '*.desc' -o -name '*.qml' \) -exec sed -i \
        -e 's/Debian GNU\/Linux/Uhuru OS/g' \
        -e 's/Debian 12/Uhuru OS 1.0/g' \
        -e 's/Debian/Uhuru OS/g' \
        -e "s#https\?://[A-Za-z.]*debian\.org[^ \"<]*#$SITE#g" {} +
    if [ -f "$LOGO" ]; then
        for img in "$CAL"/*.png; do
            [ -f "$img" ] && cp "$LOGO" "$img" || true
        done
    fi
    if [ -f "$CAL/show.qml" ]; then
        sed -i 's#Welcome to Uhuru OS#Welcome to Uhuru OS - Imetengenezwa na Letema Group Tech (letemagrouptech.lsicbusiness.online)#' "$CAL/show.qml"
    fi
    if [ -f /usr/share/pixmaps/letema-logo.png ]; then
        cp /usr/share/pixmaps/letema-logo.png "$CAL/letema-logo.png"
    fi
fi

# 8. Jina kamili la mtumiaji wa live (live-config)
for f in /usr/lib/live/config/*; do
    [ -f "$f" ] && sed -i 's/Debian Live/Uhuru OS Live/g' "$f" || true
done

# 9. Maandishi yanayoonekana kwenye .desktop (Name, GenericName, Comment) kwenye menyu na xfce4
find /usr/share/applications /usr/share/xfce4 -name '*.desktop' -exec sed -i \
    '/^\(Name\|GenericName\|Comment\)/s/Debian/Uhuru OS/g' {} + 2>/dev/null || true

# 10. Jina la muuzaji kwenye xfce4 (dirisha la About)
if [ -f /usr/share/xfce4/vendorinfo ]; then
    sed -i 's/Debian/Uhuru OS/g' /usr/share/xfce4/vendorinfo
fi

# 11. Jina la mtumiaji wa live na ujumbe wa live-boot: lengo la moja kwa moja
for f in /usr/lib/live/config/init-config.sh /usr/lib/live/boot/9990-initramfs-tools.sh; do
    if [ -f "$f" ]; then
        sed -i -e 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="Uhuru OS user"/' \
               -e 's/Debian Live/Uhuru OS Live/g' "$f"
    fi
done
for f in $(find /usr/lib/live -type f 2>/dev/null); do
    if grep -q "LIVE_USER_FULLNAME=\"Debian" "$f" 2>/dev/null; then
        sed -i 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="Uhuru OS user"/' "$f"
    fi
done

# 12. Password ya live user: "uhuru" (username inabaki "user")
#     live-config huweka password kwa hash ya DES crypt kwenye 0030-user-setup.
#     Hash ya "live"  = 8Ab05sVQ4LLps  (chaguo-msingi ya Debian)
#     Hash ya "uhuru" = 8Anb4IpaWQzBY  (perl -e 'print crypt("uhuru","8A")')
UFILE=/usr/lib/live/config/0030-user-setup
OLD_HASH='8Ab05sVQ4LLps'
NEW_HASH='8Anb4IpaWQzBY'
if [ -f "$UFILE" ] && grep -q "_PASSWORD=\"$OLD_HASH\"" "$UFILE"; then
    sed -i "s|_PASSWORD=\"$OLD_HASH\"|_PASSWORD=\"$NEW_HASH\"|" "$UFILE"
    grep -q "_PASSWORD=\"$NEW_HASH\"" "$UFILE" || { echo "ERROR: password haikubadilika kwenye $UFILE" >&2; exit 1; }
    echo "Live password: imewekwa kuwa uhuru"
else
    echo "ERROR: mstari wa _PASSWORD haukupatikana kwenye $UFILE" >&2
    exit 1
fi

# 13. Lock screen: IWASHE (akaunti sasa ni halisi). Epuka lockers mbili kwa pamoja.
rm -f /etc/xdg/autostart/xfce4-screensaver.desktop
rm -f /etc/xdg/autostart/xscreensaver.desktop
if grep -rqs "apps.light-locker" /usr/share/glib-2.0/schemas 2>/dev/null; then
    cat > /usr/share/glib-2.0/schemas/90_uhuru-os.gschema.override <<'EOF'
[apps.light-locker]
lock-on-suspend=true
late-locking=false
lock-after-screensaver=uint32 0
EOF
    glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || echo "WARNING: glib-compile-schemas imefeli" >&2
else
    echo "WARNING: schema ya light-locker haipo; lock screen inatumia mipangilio ya default" >&2
fi

# 14. Wizard ya kujisajili (OOBE): hakikisha faili zipo na zinaweza kuendeshwa
command -v zenity >/dev/null 2>&1 || { echo "ERROR: zenity haijasakinishwa (angalia config/package-lists/uhuru-setup.list.chroot)" >&2; exit 1; }
for f in /usr/local/bin/uhuru-setup /usr/local/sbin/uhuru-create-user /etc/xdg/autostart/uhuru-setup.desktop; do
    [ -f "$f" ] || { echo "ERROR: $f haipo (angalia config/includes.chroot)" >&2; exit 1; }
done
chmod 0755 /usr/local/bin/uhuru-setup /usr/local/sbin/uhuru-create-user
chmod 0644 /etc/xdg/autostart/uhuru-setup.desktop

# 15. Utambulisho wa mfumo: os-release, issue, motd
OSR=$(readlink -f /etc/os-release 2>/dev/null || true)
if [ -n "$OSR" ] && [ -f "$OSR" ]; then
    sed -i -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Uhuru OS 1.0"/' \
           -e 's/^NAME=.*/NAME="Uhuru OS"/' \
           -e "s#^HOME_URL=.*#HOME_URL=\"$SITE\"#" \
           -e "s#^SUPPORT_URL=.*#SUPPORT_URL=\"$SITE\"#" \
           -e "s#^BUG_REPORT_URL=.*#BUG_REPORT_URL=\"$SITE\"#" "$OSR" || true
fi
printf 'Uhuru OS 1.0 \\n \\l\n\n' > /etc/issue
printf 'Uhuru OS 1.0\n' > /etc/issue.net
printf '\nKaribu Uhuru OS 1.0\nImetengenezwa na Letema Group Tech - %s\n\n' "$SITE" > /etc/motd

# 16. GRUB ya mfumo utakaosakinishwa: jina la distributor
if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Uhuru OS"/' /etc/default/grub || true
fi

# 17. Saa ya Afrika Mashariki kama chaguo-msingi (mtumiaji anaweza kuchagua kingine kwenye wizard)
TZNAME=Africa/Dar_es_Salaam
if [ -f "/usr/share/zoneinfo/$TZNAME" ]; then
    echo "$TZNAME" > /etc/timezone
    ln -sf "/usr/share/zoneinfo/$TZNAME" /etc/localtime
fi

# 18. Wallpaper ya desktop (desktop-base) na login screen (lightdm-gtk-greeter)
BG_DIR=/usr/share/backgrounds/uhuru-os
WP_PNG="$BG_DIR/uhuru-os-wallpaper.png"
LOGIN_PNG="$BG_DIR/uhuru-os-login.png"
if [ -f "$WP_PNG" ]; then
    WP_SVG="$BG_DIR/uhuru-os-wallpaper.svg"
    {
        printf '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1920" height="1080" viewBox="0 0 1920 1080"><image width="1920" height="1080" xlink:href="data:image/png;base64,'
        base64 -w0 "$WP_PNG"
        printf '"/></svg>\n'
    } > "$WP_SVG"
    # a) Badilisha wallpaper za Debian (desktop-base) kuwa za Uhuru
    for dir in /usr/share/desktop-base/*/wallpaper/contents/images; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.svg; do
            [ -e "$f" ] && ln -sf "$WP_SVG" "$f" || true
        done
    done
    # b) Alternative ya desktop-background (njia halisi ya link inasomwa kutoka mfumo)
    if command -v update-alternatives >/dev/null 2>&1; then
        ALT_LINK=$(update-alternatives --query desktop-background 2>/dev/null | sed -n 's/^Link: //p')
        if [ -n "$ALT_LINK" ]; then
            update-alternatives --install "$ALT_LINK" desktop-background "$WP_SVG" 100000 || true
            update-alternatives --set desktop-background "$WP_SVG" || true
        fi
    fi
else
    echo "WARNING: wallpaper ya Uhuru haipo: $WP_PNG" >&2
fi
if [ -d /etc/lightdm ] && [ -f "$LOGIN_PNG" ]; then
    cat > /etc/lightdm/lightdm-gtk-greeter.conf <<EOF
[greeter]
background=$LOGIN_PNG
user-background=false
clock-format=%a %d %b, %H:%M
indicators=~host;~spacer;~clock;~spacer;~language;~session;~a11y;~power
position=50%,center 50%,center
font-name=Sans 11
EOF
fi

# 19. Firefox: homepage na bookmark ya Letema Group Tech
for FFDIR in /usr/lib/firefox-esr /usr/lib/firefox; do
    if [ -d "$FFDIR" ]; then
        mkdir -p "$FFDIR/distribution"
        cat > "$FFDIR/distribution/policies.json" <<EOF
{
  "policies": {
    "Homepage": { "URL": "$SITE", "Locked": false, "StartPage": "homepage" },
    "OverrideFirstRunPage": "$SITE",
    "DontCheckDefaultBrowser": true,
    "ManagedBookmarks": [
      { "toplevel_name": "Uhuru OS" },
      { "name": "Letema Group Tech", "url": "$SITE" }
    ]
  }
}
EOF
    fi
done

# 20. Launchers na Desktop: ruhusa
chmod 0755 /usr/local/bin/uhuru-about 2>/dev/null || true
[ -f /etc/skel/Desktop/letema-group-tech.desktop ] && chmod 0755 /etc/skel/Desktop/letema-group-tech.desktop || true

# 21. Firewall (ufw) iwashwe kwa default
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf || true
    systemctl enable ufw >/dev/null 2>&1 || true
fi

echo "Plymouth default: $(readlink -f /usr/share/plymouth/themes/default.plymouth 2>/dev/null || echo haijulikani)"
echo "Uhuru OS branding hook (v13.1): imekamilika."
