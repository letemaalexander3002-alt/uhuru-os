#!/bin/sh
# Uhuru OS — Awamu ya 2: msingi wa Debian 12 (bookworm) + XFCE + Calamares
# Hakuna branding hapa (branding ni Awamu ya 3).
set -e

lb config noauto \
  --mode debian \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures amd64 \
  --linux-flavours amd64 \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --apt-recommends false \
  --memtest none \
  --iso-application "Uhuru OS" \
  --iso-publisher "Letema Group Tech" \
  --iso-volume "UHURU_OS" \
  "${@}"
