#!/bin/sh
# Uhuru OS — Awamu ya 2: msingi wa Debian 12 (bookworm) + XFCE + Calamares
# Hakuna branding hapa (branding ni Awamu ya 3).
set -e

lb config noauto \
  --mode debian \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures amd64 \
  --linux-flavours amd64 \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --apt-recommends false \
  --memtest none \
  --bootappend-live "boot=live components username=mtumiaji hostname=uhuru-os locales=sw_TZ.UTF-8 keyboard-layouts=us user-default-password=uhuru quiet splash console=tty0 console=ttyS0,115200n8" \
  --iso-volume "UHURU_OS" \
  --iso-application "Uhuru OS" \
  --iso-publisher "Letema Group Tech; https://www.letemagrouptech.lsicbusiness.online" \
  --iso-preparer "Letema Group Tech" \
  "${@}"
